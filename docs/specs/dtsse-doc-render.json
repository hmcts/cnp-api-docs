      },
      "PingApi": {
        "get": {
          "operationId": "pingApi",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Responds with the text `pong`",
          "description": "Answers GET only.",
          "responses": {
            "200": {
              "description": "pong",
              "content": {
                "text/plain": {
                  "schema": {
                    "type": "string",
                    "const": "pong"
                  }
                }
              }
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      },
      "RenderApi": {
        "post": {
          "operationId": "renderApi",
          "tags": [
            "Rendering"
          ],
          "summary": "Merge a template with data and return the document",
          "description": "The template travels with the request. Send JSON (`templateBase64`), a multipart form (`templateFile`),\nor a form-urlencoded body with the same fields as the JSON one.\n\nA template that does not merge cleanly is a 400, unless `devMode` is true, which returns the document\nwith the merge problems written into it.\n\n`outputFormat` wins over the extension of `outputName`. Without `outputFormat`, `outputName` must end in a\nknown extension, and defaults to `output.pdf`.\n",
          "requestBody": {
            "$ref": "#/components/requestBodies/Render"
          },
          "responses": {
            "200": {
              "$ref": "#/components/responses/Rendered"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            },
            "413": {
              "$ref": "#/components/responses/TooLarge"
            },
            "500": {
              "$ref": "#/components/responses/ServerError"
            },
            "503": {
              "$ref": "#/components/responses/Busy"
            }
          }
        }
      },
      "ConvertApi": {
        "post": {
          "operationId": "convertApi",
          "tags": [
            "Rendering"
          ],
          "summary": "Convert an uploaded document to PDF",
          "description": "Accepts the document types LibreOffice can open from the uploaded file's extension (docx, doc, odt, rtf,\nxlsx, pptx and the like). A type it does not accept, or a file whose content does not match its extension, is refused with a 400.\n",
          "requestBody": {
            "$ref": "#/components/requestBodies/Convert"
          },
          "responses": {
            "200": {
              "$ref": "#/components/responses/Converted"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            },
            "413": {
              "$ref": "#/components/responses/TooLarge"
            },
            "500": {
              "$ref": "#/components/responses/ServerError"
            },
            "503": {
              "$ref": "#/components/responses/Busy"
            }
          }
        }
      },
      "GetTemplateStructureApi": {
        "get": {
          "operationId": "getTemplateStructureApi",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        },
        "post": {
          "operationId": "getTemplateStructurePostApi",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "responses": {
