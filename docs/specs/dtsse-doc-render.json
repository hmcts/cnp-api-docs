          ],
          "summary": "Not implemented",
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        },
        "post": {
          "operationId": "getSampleDataPostApi",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      }
    },
    "schemas": {
      "OutputFormat": {
        "type": "string",
        "enum": [
          "pdf",
          "docx",
          "doc",
          "odt",
          "html",
          "txt"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "ready",
          "service",
          "engine"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "service": {
            "type": "string",
            "const": "dtsse-doc-render"
          },
          "engine": {
            "type": "string",
            "const": "libreoffice"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The Docmosis error shape.",
        "required": [
          "succeeded",
          "shortMsg",
          "longMsg"
        ],
        "properties": {
          "succeeded": {
            "type": "boolean",
            "const": false
          },
          "shortMsg": {
            "type": "string"
          },
          "longMsg": {
            "type": "string"
          }
        }
      },
      "RenderRequest": {
        "type": "object",
        "required": [
          "templateBase64"
        ],
        "properties": {
          "templateBase64": {
            "type": "string",
            "description": "The .docx template, base64 encoded. A `data:` URL prefix, whitespace and the URL-safe alphabet are accepted."
          },
          "templateName": {
            "type": "string",
            "description": "Used only to name the template in error messages."
          },
          "includes": {
            "type": "object",
            "description": "Templates that `ref:` and `refLookup:` tags may name, from the name the tag uses to the .docx, base64 encoded. At most 100.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "outputName": {
            "type": "string",
            "default": "output.pdf",
            "description": "The name of the returned attachment."
          },
          "outputFormat": {
            "$ref": "#/components/schemas/OutputFormat"
          },
          "devMode": {
            "type": "boolean",
            "default": false,
            "description": "Return the document with merge problems written into it, instead of failing with a 400."
          },
          "data": {
            "description": "The merge data. A string is parsed as JSON.",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          },
          "accessKey": {
            "type": "string",
            "description": "Accepted so that Docmosis clients need no change, and ignored."
          }
        }
      },
      "RenderForm": {
        "type": "object",
        "required": [
          "templateFile"
        ],
        "properties": {
          "templateFile": {
            "type": "string",
            "format": "binary",
            "description": "The .docx template."
          },
          "include": {
            "type": "array",
            "description": "Templates that `ref:` and `refLookup:` tags may name. Each part's filename is the name the tag uses. At most 100.",
            "items": {
              "type": "string",
              "format": "binary"
            }
          },
          "data": {
            "type": "string",
            "description": "The merge data as JSON, either a form field or a file part."
          },
          "outputName": {
            "type": "string",
            "default": "output.pdf"
          },
          "outputFormat": {
            "$ref": "#/components/schemas/OutputFormat"
          },
          "devMode": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ConvertForm": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The document to convert. Its filename extension says what it is."
          },
          "outputName": {
            "type": "string",
            "default": "output.pdf"
          }
        }
      }
    },
    "requestBodies": {
      "Render": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RenderRequest"
            }
          },
          "multipart/form-data": {
            "schema": {
              "$ref": "#/components/schemas/RenderForm"
            },
            "encoding": {
              "templateFile": {
                "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              },
              "include": {
                "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              },
              "data": {
                "contentType": "application/json"
              }
            }
          }
        }
      },
      "Convert": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "$ref": "#/components/schemas/ConvertForm"
            }
          }
        }
      }
    },
    "responses": {
      "Rendered": {
        "description": "The rendered document.",
        "headers": {
          "Content-Disposition": {
            "description": "An attachment named from `outputName`, with an RFC 5987 UTF-8 filename.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/pdf": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "application/msword": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "application/vnd.oasis.opendocument.text": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "text/html": {
            "schema": {
              "type": "string"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Converted": {
        "description": "The PDF.",
        "headers": {
          "Content-Disposition": {
            "description": "An attachment named from `outputName`.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/pdf": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "Up": {
        "description": "Up.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Health"
            },
            "example": {
              "status": "UP"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request, the template or its data is invalid, or the merge failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "succeeded": false,
              "shortMsg": "Invalid template",
              "longMsg": "the inline template is not a .docx"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such endpoint.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The path does not answer this method. The `Allow` header lists the ones it does.",
        "headers": {
          "Allow": {
            "description": "The methods the path answers.",
            "schema": {
              "type": "string"
            },
            "example": "POST"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The request body is over the 50 MiB limit. The connection is closed after the response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "The conversion failed, or timed out, or the service failed unexpectedly.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotImplemented": {
        "description": "A Docmosis operation this service does not implement.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "succeeded": false,
              "shortMsg": "not supported by dtsse-doc-render",
              "longMsg": "This Docmosis operation is not implemented by dtsse-doc-render"
            }
          }
        }
      },
      "Busy": {
        "description": "The conversion queue is full or a slot did not free up in time. Retry after the delay.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            },
            "example": 5
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
