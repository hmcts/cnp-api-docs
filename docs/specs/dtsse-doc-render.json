            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        },
        "post": {
          "operationId": "getSampleDataPost",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      },
      "StatusApi": {
        "get": {
          "operationId": "statusApi",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Whether the service can render",
          "description": "Answers GET only. `ready` is false while LibreOffice cannot convert.",
          "responses": {
            "200": {
              "description": "The service and its converter.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Status"
                  }
                }
              }
