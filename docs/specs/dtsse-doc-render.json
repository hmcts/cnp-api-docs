{
  "openapi": "3.1.0",
  "info": {
    "title": "dtsse-doc-render",
    "version": "1.0.0",
    "summary": "Docmosis-compatible template merge and conversion service.",
    "description": "Renders a Word (.docx) template with JSON data and converts the result to PDF, DOCX, DOC, ODT, HTML or TXT.\nIt implements the Docmosis Tornado REST operations that services use (`render` and `convert`), under both the\n`/rs` and the `/api` prefix, so an existing Docmosis client only changes its base URL.\n\nTemplates are always sent with the request, either inline (`templateBase64`, `templateFile`) or as `includes`.\nNaming a stored template is not supported, and nothing is stored between requests. There is no authentication:\nan `accessKey` is accepted and ignored.\n\nErrors use the Docmosis shape: `{\"succeeded\": false, \"shortMsg\": \"...\", \"longMsg\": \"...\"}`.\n\nThe `/rs/*` and `/api/*` paths are the same operations. Each `/api/*` operation has the `Api` suffix on its\n`operationId`, and shares its request and response definitions with the `/rs/*` one.\n",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "contact": {
      "name": "DTS Software Engineering",
      "url": "https://github.com/hmcts/dtsse-doc-render"
    }
  },
  "servers": [
    {
      "url": "https://doc-render.aat.platform.hmcts.net",
      "description": "AAT, reachable from the HMCTS network only."
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Rendering",
      "description": "Merge a template with data, and convert documents."
    },
    {
      "name": "Docmosis compatibility",
      "description": "Docmosis operations that exist so a Docmosis client works unchanged."
    },
    {
      "name": "Operations",
      "description": "Health checks and this document."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "Operations"
        ],
        "summary": "Liveness, for the platform health check",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Up"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/health/liveness": {
      "get": {
        "operationId": "liveness",
        "tags": [
          "Operations"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Up"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/health/readiness": {
      "get": {
        "operationId": "readiness",
        "tags": [
          "Operations"
        ],
        "summary": "Readiness, which is whether LibreOffice can convert",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Up"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "description": "The converter is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "DOWN"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.yaml": {
      "get": {
        "operationId": "openapi",
        "tags": [
          "Operations"
        ],
        "summary": "This document",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/yaml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/rs/status": {
      "$ref": "#/components/pathItems/Status"
    },
    "/api/status": {
      "$ref": "#/components/pathItems/StatusApi"
    },
    "/rs/ping": {
      "$ref": "#/components/pathItems/Ping"
    },
    "/api/ping": {
      "$ref": "#/components/pathItems/PingApi"
    },
    "/rs/render": {
      "$ref": "#/components/pathItems/Render"
    },
    "/api/render": {
      "$ref": "#/components/pathItems/RenderApi"
    },
    "/rs/convert": {
      "$ref": "#/components/pathItems/Convert"
    },
    "/api/convert": {
      "$ref": "#/components/pathItems/ConvertApi"
    },
    "/rs/getTemplateStructure": {
      "$ref": "#/components/pathItems/GetTemplateStructure"
    },
    "/api/getTemplateStructure": {
      "$ref": "#/components/pathItems/GetTemplateStructureApi"
    },
    "/rs/getSampleData": {
      "$ref": "#/components/pathItems/GetSampleData"
    },
    "/api/getSampleData": {
      "$ref": "#/components/pathItems/GetSampleDataApi"
    }
  },
  "components": {
    "pathItems": {
      "Status": {
        "get": {
          "operationId": "status",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Whether the service can render",
          "description": "Answers GET only. `ready` is false while LibreOffice cannot convert.",
          "responses": {
            "200": {
              "description": "The service and its converter.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Status"
                  }
                }
              }
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      },
      "Ping": {
        "get": {
          "operationId": "ping",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Responds with the text `pong`",
          "description": "Answers GET only.",
          "responses": {
            "200": {
              "description": "pong",
              "content": {
                "text/plain": {
                  "schema": {
                    "type": "string",
                    "const": "pong"
                  }
                }
              }
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      },
      "Render": {
        "post": {
          "operationId": "render",
          "tags": [
            "Rendering"
          ],
          "summary": "Merge a template with data and return the document",
          "description": "The template travels with the request. Send JSON (`templateBase64`), a multipart form (`templateFile`),\nor a form-urlencoded body with the same fields as the JSON one.\n\nA template that does not merge cleanly is a 400, unless `devMode` is true, which returns the document\nwith the merge problems written into it.\n\n`outputFormat` wins over the extension of `outputName`. Without `outputFormat`, `outputName` must end in a\nknown extension, and defaults to `output.pdf`.\n",
          "requestBody": {
            "$ref": "#/components/requestBodies/Render"
          },
          "responses": {
            "200": {
              "$ref": "#/components/responses/Rendered"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            },
            "413": {
              "$ref": "#/components/responses/TooLarge"
            },
            "500": {
              "$ref": "#/components/responses/ServerError"
            },
            "503": {
              "$ref": "#/components/responses/Busy"
            }
          }
        }
      },
      "Convert": {
        "post": {
          "operationId": "convert",
          "tags": [
            "Rendering"
          ],
          "summary": "Convert an uploaded document to PDF",
          "description": "Accepts the document types LibreOffice can open from the uploaded file's extension (docx, doc, odt, rtf,\nxlsx, pptx and the like). A type it does not accept, or a file whose content does not match its extension, is refused with a 400.\n",
          "requestBody": {
            "$ref": "#/components/requestBodies/Convert"
          },
          "responses": {
            "200": {
              "$ref": "#/components/responses/Converted"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            },
            "413": {
              "$ref": "#/components/responses/TooLarge"
            },
            "500": {
              "$ref": "#/components/responses/ServerError"
            },
            "503": {
              "$ref": "#/components/responses/Busy"
            }
          }
        }
      },
      "GetTemplateStructure": {
        "get": {
          "operationId": "getTemplateStructure",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        },
        "post": {
          "operationId": "getTemplateStructurePost",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "responses": {
            "501": {
              "$ref": "#/components/responses/NotImplemented"
            },
            "405": {
              "$ref": "#/components/responses/MethodNotAllowed"
            }
          }
        }
      },
      "GetSampleData": {
        "get": {
          "operationId": "getSampleData",
          "tags": [
            "Docmosis compatibility"
          ],
          "summary": "Not implemented",
