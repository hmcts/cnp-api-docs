---
import Base from '../layouts/Base.astro';
import { rankedServices, freshnessOf, pathCountOf, slugFor, counts, services } from '../lib/model.mjs';

const base = import.meta.env.BASE_URL;
const listed = rankedServices().filter((s) => s.specs.length > 0);

const freshCount = services.filter((s) => freshnessOf(s) === 'fresh').length;
const staleCount = services.filter((s) => {
  const f = freshnessOf(s);
  return f === 'abandoned' || f === 'unpublished';
}).length;
---

<Base
  title="Specs"
  description="Every OpenAPI spec published by an HMCTS CFT service."
>
  <h1>Specs</h1>

  <ul class="stats">
    <li><span class="n">{counts.specFiles}</span><span class="k">published specs</span></li>
    <li><span class="n">{freshCount}</span><span class="k">updated in 90 days</span></li>
    <li><span class="n">{staleCount}</span><span class="k">not published in 2 years</span></li>
    <li><span class="n">{counts.products}</span><span class="k">products</span></li>
  </ul>

  <label class="search">
    <span>Search by name, product or title</span>
    <input
      type="search"
      id="q"
      placeholder="e.g. ccd, payments, hearings"
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <table id="tbl">
    <thead>
      <tr>
        <th scope="col">Service</th>
        <th scope="col">Product</th>
        <th scope="col" class="num">Paths</th>
        <th scope="col">Last published</th>
      </tr>
    </thead>
    <tbody>
      {listed.map((s) => {
        const fresh = freshnessOf(s);
        const newest = s.specs
          .filter((x) => x.lastPublished)
          .sort((a, b) => b.lastPublished.localeCompare(a.lastPublished))[0];
        const broken = s.brokenSpecs > 0;
        return (
          <tr data-hay={`${s.id} ${s.product ?? ''} ${s.specs.map((x) => x.title ?? '').join(' ')}`.toLowerCase()}>
            <td>
              <a href={`${base}/service/${slugFor(s.id)}/`}>{s.id}</a>
              {s.specs.length > 1 && <span class="muted"> ({s.specs.length} specs)</span>}
              {broken && <> <span class="tag broken">broken</span></>}
            </td>
            <td>{s.product ? <a href={`${base}/products/${slugFor(s.product)}/`}>{s.product}</a> : <span class="muted">unassigned</span>}</td>
            <td class="num">{pathCountOf(s) || ''}</td>
            <td>
              {newest?.lastPublished ?? <span class="muted">unknown</span>}
              {' '}<span class={`tag ${fresh}`}>{fresh}</span>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <style>
    .search { display: block; margin: 24px 0 8px; }
    .search span { display: block; font-weight: 700; margin-bottom: 6px; }
    .search input {
      font: inherit;
      padding: 8px 10px;
      border: 2px solid var(--text);
      width: 100%;
      max-width: 30em;
    }
    .search input:focus { outline: 3px solid var(--focus); outline-offset: 0; }
    tr[hidden] { display: none; }

    /* Service takes the slack; the rest are sized to their content so the header
       rule does not run past the last column. */
    #tbl { table-layout: fixed; }
    #tbl th:nth-child(1) { width: auto; }
    #tbl th:nth-child(2) { width: 9em; }
    #tbl th:nth-child(3) { width: 5em; }
    #tbl th:nth-child(4) { width: 13em; }
  </style>

  <script>
    // Plain DOM filtering: the table is already in the HTML, so search costs no
    // extra payload and works on the first paint.
    const q = document.getElementById('q');
    const rows = Array.from(document.querySelectorAll('#tbl tbody tr'));

    function apply() {
      const needle = q.value.trim().toLowerCase();
      for (const row of rows) {
        row.hidden = Boolean(needle) && !row.dataset.hay.includes(needle);
      }
    }

    q.addEventListener('input', apply);
    // Support deep links like ?q=ccd from other pages.
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { q.value = initial; apply(); }
  </script>
</Base>
