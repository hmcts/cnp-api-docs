---
import Base from '../../layouts/Base.astro';
import { products, model, slugFor, freshnessOf } from '../../lib/model.mjs';

const base = import.meta.env.BASE_URL;

const rows = products
  .map((p) => {
    const members = p.services.map((id) => model.services[id]).filter(Boolean);
    const specs = members.flatMap((m) => m.specs);
    return {
      ...p,
      members,
      specCount: specs.length,
      fresh: members.filter((m) => freshnessOf(m) === 'fresh').length,
    };
  })
  .sort((a, b) => b.specCount - a.specCount || a.name.localeCompare(b.name));

const unassigned = Object.values(model.services).filter((s) => !s.product && s.specs.length > 0);
---

<Base title="Products" description="CFT services by product.">
  <h1>Products</h1>
  <table>
    <thead>
      <tr>
        <th scope="col">Product</th>
        <th scope="col" class="num">Services</th>
        <th scope="col" class="num">Specs</th>
        <th scope="col" class="num">Fresh</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <td><a href={`${base}/products/${slugFor(p.name)}/`}>{p.name}</a></td>
          <td class="num">{p.members.length}</td>
          <td class="num">{p.specCount || ''}</td>
          <td class="num">{p.fresh || ''}</td>
        </tr>
      ))}
    </tbody>
  </table>

  {unassigned.length > 0 && (
    <>
      <h2>Not yet assigned to a product</h2>
      <p>
        {unassigned.length} services publish a spec but have no registry entry, so they have
        no product. They are listed in the catalogue, and can be assigned by adding them to
        <code>registry.yaml</code>.
      </p>
      <div class="chips">
        {unassigned.map((s) => (
          <a class="chip" href={`${base}/service/${slugFor(s.id)}/`}>{s.id}</a>
        ))}
      </div>
    </>
  )}
</Base>
