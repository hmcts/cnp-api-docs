---
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}/`, label: 'Catalogue' },
  { href: `${base}/groups/`, label: 'Groups' },
  { href: `${base}/health/`, label: 'Registry health' },
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — CFT API catalogue` : 'CFT API catalogue'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header>
      <div class="wrap head">
        <a class="brand" href={`${base}/`}>CFT API catalogue</a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <p>
          Specs are published by each service's own pipeline into
          <a href="https://github.com/hmcts/cnp-api-docs">hmcts/cnp-api-docs</a>.
          Every spec in <code>docs/specs/</code> appears here automatically.
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --text: #0b0c0c;
        --muted: #505a5f;
        --line: #b1b4b6;
        --bg: #ffffff;
        --link: #1d70b8;
        --link-visited: #4c2c92;
        --focus: #ffdd00;
        --fresh: #00703c;
        --ageing: #b58840;
        --stale: #d4351c;
        --abandoned: #505a5f;
        --panel: #f3f2f1;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "GDS Transport", arial, sans-serif;
        font-size: 19px;
        line-height: 1.5;
      }

      .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 0; top: 0; z-index: 10;
        background: var(--focus); color: var(--text);
        padding: 12px 16px;
      }

      header { border-bottom: 10px solid var(--text); background: var(--text); }
      .head { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; padding: 12px 20px; }
      .brand { color: #fff; font-weight: 700; font-size: 22px; text-decoration: none; }
      .head nav { display: flex; gap: 20px; margin-left: auto; }
      .head nav a { color: #fff; text-decoration: none; padding: 4px 0; }
      .head nav a:hover { text-decoration: underline; }
      .head nav a[aria-current="page"] { border-bottom: 3px solid var(--focus); font-weight: 700; }

      main { padding: 32px 20px 64px; min-height: 60vh; }

      a { color: var(--link); }
      a:visited { color: var(--link-visited); }
      a:focus {
        outline: 3px solid transparent;
        background: var(--focus);
        box-shadow: 0 -2px var(--focus), 0 4px var(--text);
        color: var(--text);
        text-decoration: none;
      }

      h1 { font-size: 2.2rem; line-height: 1.15; margin: 0 0 8px; }
      h2 { font-size: 1.5rem; margin: 40px 0 12px; }
      h3 { font-size: 1.15rem; margin: 24px 0 8px; }
      p { margin: 0 0 16px; }
      code { font-family: ui-monospace, "SFMono-Regular", Menlo, monospace; font-size: 0.9em; }

      .lede { font-size: 1.15rem; color: var(--muted); max-width: 46em; }

      table { border-collapse: collapse; width: 100%; margin: 16px 0 32px; font-size: 0.95rem; }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { border-bottom: 2px solid var(--text); }
      td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }

      .tag {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 2px 8px;
        border: 2px solid currentColor;
        white-space: nowrap;
      }
      .tag.fresh { color: var(--fresh); }
      .tag.ageing { color: var(--ageing); }
      .tag.stale { color: var(--stale); }
      .tag.abandoned, .tag.unpublished { color: var(--abandoned); }
      .tag.broken { color: #fff; background: var(--stale); border-color: var(--stale); }

      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chip {
        font-size: 0.78rem;
        padding: 2px 8px;
        background: var(--panel);
        border: 1px solid var(--line);
        white-space: nowrap;
      }

      .panel { background: var(--panel); padding: 16px 20px; margin: 0 0 24px; }
      .panel.warn { background: #fff; border-left: 5px solid var(--stale); }

      .muted { color: var(--muted); }
      .stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0 32px; padding: 0; list-style: none; }
      .stats li { flex: 1 1 150px; border-left: 5px solid var(--line); padding: 4px 0 4px 14px; }
      .stats .n { display: block; font-size: 1.9rem; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
      .stats .k { color: var(--muted); font-size: 0.85rem; }

      footer { border-top: 1px solid var(--line); padding: 24px 0 48px; color: var(--muted); font-size: 0.9rem; }
      footer p { max-width: 60em; }

      @media (max-width: 640px) {
        body { font-size: 17px; }
        .head nav { margin-left: 0; width: 100%; }
      }
    </style>
  </body>
</html>
