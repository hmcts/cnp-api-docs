{
  "name": "cnp-api-docs",
  "version": "2.0.0",
  "description": "Swagger docs for all CNP APIs",
  "private": true,
  "workspaces": [
    "site"
  ],
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmcts/cnp-api-docs.git"
  },
  "scripts": {
    "start": "http-server -p 8080 docs/",
    "test": "jasmine JASMINE_CONFIG_PATH=package.json && node --test test/*.test.mjs",
    "validate-specs": "node bin/validate-specs.mjs",
    "normalise-specs": "node bin/normalise-specs.mjs",
    "build-model": "node bin/normalise-specs.mjs && node model/build.mjs",
    "refresh-catalog-cache": "node bin/refresh-catalog-cache.mjs",
    "build-site": "yarn workspace cnp-api-docs-site build",
    "assemble": "node bin/assemble-site.mjs",
    "serve-site": "node bin/serve-site.mjs",
    "update-swagger": "cp node_modules/swagger-ui-dist/swagger-ui* docs/",
    "update-vis": "cp node_modules/vis/dist/vis-network* docs/ && cp -r node_modules/vis/dist/img docs/"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hmcts/cnp-api-docs/issues"
  },
  "homepage": "https://github.com/hmcts/cnp-api-docs#readme",
  "dependencies": {
    "djv": "^2.1.4",
    "jasmine": "^4.3.0",
    "moment": "~2.29.4",
    "swagger-ui-dist": "^5.18.2",
    "swagger2openapi": "^7.0.8",
    "vis": "^4.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "scarfSettings": {
    "enabled": false
  },
  "spec_dir": "test",
  "spec_files": [
    "**/*.js"
  ]
}
