{
  "name": "cnp-api-docs",
  "version": "2.0.0",
  "description": "Swagger docs for all CNP APIs",
  "private": true,
  "workspaces": [
    "site"
  ],
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmcts/cnp-api-docs.git"
  },
  "scripts": {
    "dev": "yarn build && yarn serve-site",
    "build": "yarn build-site && yarn build-c4 && yarn assemble",
    "test": "node --test test/*.test.mjs",
    "build-site": "yarn build-model && yarn workspace cnp-api-docs-site build",
    "build-c4": "yarn generate-c4 && likec4 build --no-use-dot -o build/c4 --base /cnp-api-docs/architecture/explore/ --title \"CNP API Docs\" c4",
    "generate-c4": "node bin/generate-c4.mjs && node bin/generate-c4-views.mjs",
    "validate-c4": "likec4 validate c4",
    "build-model": "node bin/normalise-specs.mjs && node model/build.mjs",
    "normalise-specs": "node bin/normalise-specs.mjs",
    "validate-specs": "node bin/validate-specs.mjs",
    "assemble": "node bin/assemble-site.mjs",
    "serve-site": "node bin/serve-site.mjs",
    "dev-site": "yarn build-model && yarn workspace cnp-api-docs-site dev-server",
    "export-readme-pngs": "node bin/export-readme-pngs.mjs",
    "refresh-catalog-cache": "node bin/refresh-catalog-cache.mjs"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hmcts/cnp-api-docs/issues"
  },
  "homepage": "https://github.com/hmcts/cnp-api-docs#readme",
  "dependencies": {
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "likec4": "^1.59.2"
  },
  "scarfSettings": {
    "enabled": false
  }
}
